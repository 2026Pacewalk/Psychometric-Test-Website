# ---- Production environment for testpsychometric.com ----
# Copy to ".env" (or ".env.production") on the server and fill real values.

# SQLite database file. Use an ABSOLUTE path on a PERSISTENT disk/volume.
# (Do NOT keep it inside the deploy folder if you redeploy by replacing the folder.)
DATABASE_URL="file:/var/data/testpsychometric/app.db"

# Long random secret for signing login sessions (CHANGE THIS).
# Generate: openssl rand -hex 48
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Public branding
NEXT_PUBLIC_SITE_NAME="TestPsychometric"
NEXT_PUBLIC_WHATSAPP_NUMBER="919041997889"

# Razorpay LIVE keys (individual + online centre payments). Leave blank to
# keep offline/manual + cash/UPI-QR flows working without online card payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Node
NODE_ENV="production"
PORT="3000"
